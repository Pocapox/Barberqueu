    "react-dom": "19.2.0",
    "tsx": "4.23.15",
    "web-push": "4.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@types/web-push": "3.6.4",
    "@vitest/coverage-v8": "5.1.0",
    "tailwindcss": "4.3.0",
